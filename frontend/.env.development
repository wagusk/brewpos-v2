# Dev environment for the frontend.
#
# The backend is reached DIRECTLY from the browser (no vite proxy).
# Backend CORS allows all origins in dev (see app/core/config.py
# cors_origins=["*"]) so cross-origin requests work without extra config.
#
# Override per-developer in .env.local (gitignored).
VITE_API_URL=http://127.0.0.1:8765
VITE_WS_URL=ws://127.0.0.1:8765/ws
